# ─── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/pharmacy_saas"

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── API ────────────────────────────────────────────────────
API_PORT=3001
API_URL="http://localhost:3001"

# ─── Web ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── FBR (Pakistan Revenue Automation) ──────────────────────
# Per-tenant — stored encrypted in DB. These are fallback/test values.
FBR_API_URL="https://esp.fbr.gov.pk:8244/FBR/v1/api/Live/PostData"
FBR_SANDBOX_URL="https://gw.fbr.gov.pk:8244/FBR/v1/api/Live/PostData"

# ─── WhatsApp (Meta Cloud API) ───────────────────────────────
META_WHATSAPP_TOKEN="your-meta-permanent-token"
META_WHATSAPP_PHONE_ID="your-phone-number-id"
META_WHATSAPP_VERIFY_TOKEN="your-webhook-verify-token"

# ─── SMS (Twilio) ────────────────────────────────────────────
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_FROM_NUMBER="+1234567890"

# ─── File Storage (Cloudflare R2) ────────────────────────────
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="pharmacy-saas"
R2_PUBLIC_URL="https://your-bucket.r2.dev"

# ─── Encryption (for sensitive per-tenant data) ──────────────
ENCRYPTION_KEY="32-byte-hex-key-for-aes-256-gcm"

# ─── Environment ────────────────────────────────────────────
NODE_ENV="development"
